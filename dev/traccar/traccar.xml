<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>

    <!-- Local development only. Documentation: https://www.traccar.org/configuration-file/ -->

    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./data/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password' />

    <!-- Unknown devices are created on their first message (fixtures, manual tests). -->
    <entry key='database.registerUnknown'>true</entry>

    <!-- Forward positions and events to traccar-adapter (PORT 3000 on the host). The URLs
         can be overridden with FORWARD_URL / EVENT_FORWARD_URL (see docker-compose.yml).
         Forwarding is enabled by the presence of the URL: 6.15.3 has no forward.enable. -->
    <entry key='forward.type'>json</entry>
    <entry key='forward.url'>http://host.docker.internal:3000/webhooks/traccar/positions</entry>
    <entry key='forward.header'>Authorization: Bearer dev-webhook-token-0123456789</entry>
    <!-- Positions only: events are never retried by Traccar 6.15.3. -->
    <entry key='forward.retry.enable'>true</entry>
    <entry key='forward.retry.delay'>1000</entry>
    <entry key='forward.retry.count'>10</entry>
    <entry key='forward.retry.limit'>10000</entry>

    <entry key='event.forward.url'>http://host.docker.internal:3000/webhooks/traccar/events</entry>
    <entry key='event.forward.header'>Authorization: Bearer dev-webhook-token-0123456789</entry>

</properties>
